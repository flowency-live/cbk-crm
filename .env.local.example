# ── Supabase ────────────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER expose to the browser. Used by agents / privileged server actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Companies House ─────────────────────────────────────────
# Free key from https://developer.company-information.service.gov.uk/
# Server-only — the app proxies all CH calls so this never reaches the browser.
COMPANIES_HOUSE_API_KEY=your-companies-house-key

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
